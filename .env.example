# Agentic Swarm API Credentials
# Copy this file to .env and fill in your actual keys.
# NEVER commit the .env file to Git!

# Primary LLM API (Groq - Llama 3.3 70B)
GROQ_API_KEY=your_groq_api_key_here

# Fallback LLM API (Google Gemini 2.0 Flash)
GEMINI_API_KEY=your_gcp_api_key_here

# OpenRouter (Optional backup)
OPENROUTER_API_KEY=your_openrouter_api_key_here
